NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/instaway
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Shown to the passenger only AFTER a booking is created (never in client code)
WALLET_NUMBER=
# Business rules (placeholders - confirm before launch)
HOLD_MINUTES=30
DEADLINE_HOURS_BEFORE=3
CANCEL_CUTOFF_HOURS=6
MAX_PENDING_PER_PHONE=3
BOOK_RATE_MAX=10
PGSSL=false
